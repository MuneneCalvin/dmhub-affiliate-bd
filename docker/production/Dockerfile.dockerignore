# Used only by docker/production/Dockerfile (BuildKit picks up <Dockerfile>.dockerignore).
# Unlike the repo-wide .dockerignore it keeps composer.lock and package-lock.json so builds are reproducible.
.git
.github
.env
.env.local*
.env.production*
.env.staging*
node_modules
vendor
storage/logs
storage/framework
storage/app
bootstrap/cache
public/hot
public/storage
tests
*.md
